      "name": "1. Twist - No double booking",
      "item": [
        {
          "name": "Test 1 - Lease Shelf 7 to Asha (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"leaseId\", pm.response.json().lease_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor_id\": 1,\n  \"shelf_id\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leases",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leases"
              ]
            }
          }
        },
        {
          "name": "Test 2 - Lease Shelf 7 to Ravi (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Message is Shelf 7 is already leased\", () => pm.expect(pm.response.json().message).to.eql(\"Shelf 7 is already leased\"));"
